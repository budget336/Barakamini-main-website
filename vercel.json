{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/mattresses", "destination": "/index.html" },
    { "source": "/fabrics", "destination": "/index.html" },
    { "source": "/leather", "destination": "/index.html" },
    { "source": "/hardware", "destination": "/index.html" },
    { "source": "/other-products", "destination": "/index.html" }
  ],
  "headers": [
    { "source": "/sw.js", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
    { "source": "/images/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] }
  ]
}
